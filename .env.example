DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_CHAT_PATH=/chat/completions
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen3.5:122b
LOCAL_LLM_TEMPERATURE=0.35

DB_URL=jdbc:postgresql://localhost:5432/wireless_lab_agent
DB_USERNAME=admin
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
CHAT_MEMORY_WINDOW_SIZE=20
CHAT_MEMORY_TTL=7d
CHAT_MEMORY_SUMMARY_BATCH_SIZE=6
CHAT_MEMORY_SUMMARY_MAX_CHARS=1200

AGENT_SDR_BASE_URL=http://127.0.0.1:8000
AGENT_SDR_MCP_URL=http://127.0.0.1:8000/mcp
SDR_MCP_ENABLED=false
SDR_AGENT_MODE=think
SDR_RESILIENCE_ENABLED=true
SDR_MCP_READ_TIMEOUT=8s
SDR_MCP_ACTION_TIMEOUT=60s
SDR_SAFE_MAX_ATTEMPTS=2
SDR_RETRY_BACKOFF=200ms
SDR_CIRCUIT_FAILURE_THRESHOLD=3
SDR_CIRCUIT_OPEN_DURATION=30s
SDR_HTTP_CONNECT_TIMEOUT=3s
SDR_HTTP_READ_TIMEOUT=75s

# 控制智能体联网检索；在 https://tavily.com/ 申请
TAVILY_API_KEY=

KNOWLEDGE_BOOTSTRAP_ENABLED=true
KNOWLEDGE_REBUILD_ON_STARTUP=false

RUN_RAG_EVALUATION=false
RAG_EVAL_MIN_HIT_RATE=0.85
RAG_EVAL_MIN_PRECISION=0.55
RAG_EVAL_MIN_NDCG=0.70
RAG_EVAL_MIN_GENERATION_SCORE=3.5
RAG_EVAL_MAX_OUT_OF_DOMAIN_HIT_RATE=0.25
RUN_ROUTE_EVALUATION=false
ROUTE_EVAL_MIN_ACCURACY=0.85
ROUTE_EVAL_MIN_MACRO_F1=0.75
RUN_APPLICATION_CONTEXT_TEST=false
