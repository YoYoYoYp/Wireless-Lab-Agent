# 实验室本地 Qwen3.5-122B（OpenAI 兼容接口，Ollama/vLLM 均可）
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen3.5:122b
MODEL_THINK=qwen3.5:122b
MODEL_FAST=qwen3.5:122b
TEMPERATURE_THINK=0.35
TEMPERATURE_FAST=0.15

# MCP / HTTP 共用的硬件 operationId 幂等状态
REDIS_URL=redis://127.0.0.1:6379/0
OPERATION_RECORD_TTL_SECONDS=604800
OPERATION_LEASE_SECONDS=300

# USRP / UHD
USRP_IP=192.168.40.2

# 百炼知识库；不使用时留空
BAILIAN_API_KEY=
BAILIAN_APP_ID=
BAILIAN_EMBEDDING_MODEL=text-embedding-v2

# 可选：外部任务控制台事件上报
CONSOLE_EVENT_URL=http://127.0.0.1:3000
CONSOLE_EVENT_TOKEN=

# 可选：GNU Radio 视频流
GR_VIDEO_SCRIPT=/absolute/path/to/bpsk_video_stream.py
GR_PYTHON=/usr/bin/python3
